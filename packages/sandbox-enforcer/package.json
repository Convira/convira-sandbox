{
  "name": "@convira/sandbox-enforcer",
  "version": "0.1.0",
  "description": "Linux kernel hardening for sandboxed processes: Landlock filesystem rulesets and seccomp-bpf syscall filters.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/Convira/convira-sandbox",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Convira/convira-sandbox.git",
    "directory": "packages/sandbox-enforcer"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "native",
    "src/profiles"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:native": "node-gyp rebuild --directory native",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "vitest": "^4.0.0"
  },
  "optionalDependencies": {
    "node-gyp": "^12.0.0"
  }
}
